import Mathlib.Analysis.Asymptotics.Defs
import Mathlib.Analysis.SpecialFunctions.Gamma.Basic
import Mathlib.Data.EReal.Operations
import Mathlib.MeasureTheory.Integral.Bochner.Basic
import Mathlib.MeasureTheory.Measure.GiryMonad
import Mathlib.MeasureTheory.Measure.Haar.InnerProductSpace

/-! Unchanged manuscript definitions shared by the proof modules and the public showcase.
Target: Lean v4.32.2; Mathlib 905b95818eb32af7874a58b427f50c1711a5e96c. -/

noncomputable section

open MeasureTheory Filter
open scoped ENNReal NNReal Topology Asymptotics Classical

namespace RieszShowcase

/-- Euclidean space with its Euclidean norm and Lebesgue measure. -/
abbrev Rd (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- The unit sphere S^d in R^(d+1). -/
abbrev Sphere (d : ℕ) := {x : Rd (d + 1) // ‖x‖ = 1}

/-- A tuple of N distinct points of the sphere. -/
abbrev SphereConfiguration (d N : ℕ) :=
  {x : Fin N → Sphere d // Function.Injective x}

/-- Chordal distance, as in the manuscript. -/
def chord (d : ℕ) (x y : Sphere d) : ℝ := ‖x.val - y.val‖

/-- Ordered pairs; the diagonal indices are omitted. -/
def rieszEnergy (d : ℕ) (s : ℝ) (N : ℕ)
    (x : SphereConfiguration d N) : ℝ :=
  ∑ i : Fin N, ∑ j : Fin N,
    if i = j then 0 else (chord d (x.val i) (x.val j)) ^ (-s)

/-- E_s(S^d;N): an infimum for s > 0 and a supremum for s < 0. -/
def E_s (d : ℕ) (s : ℝ) (N : ℕ) : ℝ :=
  if 0 < s then sInf (Set.range (rieszEnergy d s N))
  else sSup (Set.range (rieszEnergy d s N))

/-- K_s(r) = r^(-s)/s. Only positive r occur in sphere configurations. -/
def K_s (s r : ℝ) : ℝ := r ^ (-s) / s

/-- The optimal K_s-energy is an infimum for either sign of s. -/
def E_K (d : ℕ) (s : ℝ) (N : ℕ) : ℝ :=
  sInf (Set.range fun x : SphereConfiguration d N =>
    ∑ i : Fin N, ∑ j : Fin N,
      if i = j then 0 else K_s s (chord d (x.val i) (x.val j)))

/-- Surface area omega_d of the unit sphere. -/
def omega (d : ℕ) : ℝ :=
  2 * Real.pi ^ (((d : ℝ) + 1) / 2) /
    Real.Gamma (((d : ℝ) + 1) / 2)

/-- The continuous Riesz energy V_s(S^d), in the paper's explicit form. -/
def V_s (d : ℕ) (s : ℝ) : ℝ :=
  (2 : ℝ) ^ ((d : ℝ) - s - 1) *
    Real.Gamma (((d : ℝ) + 1) / 2) * Real.Gamma (((d : ℝ) - s) / 2) /
      (Real.sqrt Real.pi * Real.Gamma ((d : ℝ) - s / 2))

def V_K (d : ℕ) (s : ℝ) : ℝ := V_s d s / s

/-! ## The stationary Euclidean problem -/

/-- A locally finite counting measure with distinct sites and unit weights.
Local finiteness means that every compact set meets only finitely many sites.
The infimum defining e is over simple configurations, namely the class P_d
in the paper, rather than its larger class allowing multiplicities. -/
def IsSimpleConfiguration (d : ℕ) (μ : Measure (Rd d)) : Prop :=
  ∃ S : Set (Rd d),
    (∀ K : Set (Rd d), IsCompact K → (S ∩ K).Finite) ∧
      μ = Measure.sum (fun x : S => Measure.dirac x.val)

/-- A law of random measures, with the sigma-algebra generated by Borel counts.
Admissibility below concentrates it on simple configurations, so this is a
concrete common sample space for the configuration laws in the manuscript. -/
abbrev ConfigurationLaw (d : ℕ) := Measure (Measure (Rd d))

/-- Translation invariance is equality of probability laws, not of realizations. -/
def IsStationary (d : ℕ) (P : ConfigurationLaw d) : Prop :=
  ∀ a : Rd d,
    Measure.map (fun μ : Measure (Rd d) =>
      Measure.map (fun x : Rd d => a + x) μ) P = P

/-- The class P_d: stationary simple laws, intensity one, finite local second moments.
Extended integrals prevent an infinite count from being converted to zero. -/
def Admissible (d : ℕ) (P : ConfigurationLaw d) : Prop :=
  IsProbabilityMeasure P ∧
  (∀ᵐ μ ∂P, IsSimpleConfiguration d μ) ∧
  IsStationary d P ∧
  (∀ D : Set (Rd d), MeasurableSet D → Bornology.IsBounded D →
    (∫⁻ μ, μ D ∂P) = volume D) ∧
  (∀ D : Set (Rd d), MeasurableSet D → Bornology.IsBounded D →
    (∫⁻ μ, (μ D) ^ (2 : ℕ) ∂P) < ∞)

/-- The half-open cube [0,L)^d. -/
def cube (d : ℕ) (L : ℝ) : Set (Rd d) :=
  {x | ∀ i : Fin d, 0 ≤ x i ∧ x i < L}

/-- Q_P(u) = integral exp(-u|z|^2) d alpha_P(z).
The reduced factorial measure is evaluated directly using its defining identity:
anchor the first point in the volume-one cube [0,1)^d and sum over all other
points. For simple configurations, x != y is exactly exclusion of equal indices.
This avoids assuming an undeclared reduced-pair-measure construction. -/
def Q (d : ℕ) (P : ConfigurationLaw d) (u : ℝ) : ℝ≥0∞ :=
  ∫⁻ μ, ∫⁻ x in cube d 1, ∫⁻ y,
    if x = y then 0 else ENNReal.ofReal (Real.exp (-u * ‖y - x‖ ^ (2 : ℕ)))
    ∂μ ∂μ ∂P

def B (d : ℕ) (u : ℝ) : ℝ := (Real.pi / u) ^ ((d : ℝ) / 2)

/-- e_P(u) = Q_P(u) - (B(u)-1)_+, as a nonnegative extended number.
For admissible laws the manuscript proves Q_P(u) >= (B(u)-1)_+, so truncated
subtraction in ENNReal agrees with the manuscript's subtraction for u > 0. -/
def gaussianRemainder (d : ℕ) (P : ConfigurationLaw d) (u : ℝ) : ℝ≥0∞ :=
  Q d P u - ENNReal.ofReal (max (B d u - 1) 0)

def gamma_s (s : ℝ) : ℝ := 1 / (2 * Real.Gamma (1 + s / 2))

def c0 (d : ℕ) (s : ℝ) : ℝ :=
  -((d : ℝ) * Real.pi ^ (s / 2)) /
    (s * ((d : ℝ) - s) * Real.Gamma (1 + s / 2))

/-- W_{s,d}(P). The nonnegative integral retains +infinity; c0 is a finite shift.
In the theorem's parameter range gamma_s > 0. -/
def W (d : ℕ) (s : ℝ) (P : ConfigurationLaw d) : EReal :=
  (c0 d s : EReal) +
    ((ENNReal.ofReal (gamma_s s) *
      ∫⁻ u in Set.Ioi (0 : ℝ),
        ENNReal.ofReal (u ^ (s / 2 - 1)) * gaussianRemainder d P u) : ℝ≥0∞)

/-- The infimum is taken in the extended reals, before asserting finiteness. -/
def eExtended (d : ℕ) (s : ℝ) : EReal :=
  sInf {w | ∃ P : ConfigurationLaw d, Admissible d P ∧ W d s P = w}

/-- Real notation for e_{s,d}. The main theorem explicitly asserts that the
extended infimum equals this real value, ruling out either infinite value. -/
def e (d : ℕ) (s : ℝ) : ℝ := (eExtended d s).toReal

def C (d : ℕ) (s : ℝ) : ℝ := s * e d s

/-! ## The balanced finite-volume problem for s = -q -/

/-- The class B_m: simple configurations supported in C_m, exactly m^d points,
and mean counting measure equal to Lebesgue measure restricted to C_m. -/
def BalancedAdmissible (d m : ℕ) (P : ConfigurationLaw d) : Prop :=
  IsProbabilityMeasure P ∧
  (∀ᵐ μ ∂P,
    IsSimpleConfiguration d μ ∧
    μ (cube d (m : ℝ))ᶜ = 0 ∧ μ Set.univ = (m ^ d : ℕ)) ∧
  (∀ D : Set (Rd d), MeasurableSet D →
    (∫⁻ μ, μ D ∂P) = (volume.restrict (cube d (m : ℝ))) D)

/-- D_q(mu - 1_{C_m} dx), expanded into its three finite ordinary integrals.
This is exactly -(1/q) integral integral |x-y|^q d eta(x) d eta(y).
The diagonal contributes zero for q > 0. On balanced configurations all terms
are integrable: the total mass is fixed and the support is bounded. -/
def D_q (d : ℕ) (q : ℝ) (m : ℕ) (μ : Measure (Rd d)) : ℝ :=
  -(1 / q) *
    ((∫ x, ∫ y, ‖x - y‖ ^ q ∂μ ∂μ) -
      2 * (∫ x, ∫ y in cube d (m : ℝ), ‖x - y‖ ^ q ∂volume ∂μ) +
      (∫ x in cube d (m : ℝ), ∫ y in cube d (m : ℝ),
        ‖x - y‖ ^ q ∂volume ∂volume))

/-- b_m: infimum of the expected balanced discrepancy energy. -/
def b (d : ℕ) (q : ℝ) (m : ℕ) : ℝ :=
  sInf {r | ∃ P : ConfigurationLaw d,
    BalancedAdmissible d m P ∧ (∫ μ, D_q d q m μ ∂P) = r}

end RieszShowcase
